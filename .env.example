# Environment Variables Template
# Copy this file to .env before starting the application

# Node / App Environment
NODE_ENV=production
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your_postgres_secure_password>
POSTGRES_DB=threat_intel_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:<your_postgres_secure_password>@postgres:5432/threat_intel_db?schema=public"

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Authentication & Security
JWT_SECRET=<your_strong_jwt_secret_key>
JWT_EXPIRATION=1h
JWT_REFRESH_SECRET=<your_strong_jwt_refresh_secret_key>
JWT_REFRESH_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=12

# Local Admin Seed Credentials
ADMIN_EMAIL=admin@cyberintel.gov
ADMIN_PASSWORD=<your_admin_seed_password>

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000/api

# External Threat Feed API Keys
OTX_API_KEY=<your_alienvault_otx_api_key>
NVD_API_KEY=<your_nvd_nist_api_key>
GROQ_API_KEY=<your_groq_llm_api_key>

# OpenSearch Configuration
OPENSEARCH_NODE=http://localhost:9200

# SIEM Service Export API Key
SIEM_API_KEY=<your_siem_export_service_key>

# MISP Threat Sharing Integration
MISP_BASE_URL=http://localhost:8443
MISP_API_KEY=<your_misp_api_key>
MISP_ADMIN_PASSWORD=<your_misp_admin_password>

