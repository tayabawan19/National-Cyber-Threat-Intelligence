# Environment Variables Template
# Copy this file to .env before starting the application

# Node / App Environment
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_2026
POSTGRES_DB=threat_intel_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres_secure_pass_2026@postgres:5432/threat_intel_db?schema=public"

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_cyber_intel_2026_change_in_production
JWT_EXPIRATION=1h
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_cyber_intel_2026
JWT_REFRESH_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=10

# Local Admin Seed Credentials
ADMIN_EMAIL=admin@cyberintel.gov
ADMIN_PASSWORD=AdminSecurePass123!

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000/api

# External Threat Feed API Keys
OTX_API_KEY=your_alienvault_otx_api_key_here
NVD_API_KEY=your_nvd_nist_api_key_here

# OpenSearch Configuration
OPENSEARCH_NODE=http://localhost:9200

# SIEM Service Export API Key
SIEM_API_KEY=siem_secret_service_key_2026

# MISP Threat Sharing Integration
MISP_BASE_URL=http://localhost:8443
MISP_API_KEY=misp_secret_auth_key_2026_prod
MISP_ADMIN_PASSWORD=AdminSecurePassMISP2026!

