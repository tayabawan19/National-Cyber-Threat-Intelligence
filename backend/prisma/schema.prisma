// Prisma Schema for Cyber Threat Intelligence Platform (Phase 3 Extended)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SOC_ANALYST
  INVESTIGATOR
  READ_ONLY
}

enum ForensicArtifactType {
  LOG_FILE
  MEMORY_DUMP_META
  NETWORK_CAPTURE_META
  FILE_METADATA
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum AlertStatus {
  NEW
  TRIAGED
  RESOLVED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IocType {
  IP
  DOMAIN
  HASH
  URL
}

enum RuleCorrelationType {
  SIMPLE
  MULTI_CONDITION
  THRESHOLD
  CORRELATION
  STATISTICAL_ANOMALY
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         Role       @default(READ_ONLY)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  assignedCases Case[]     @relation("AssignedAnalyst")
  auditLogs     AuditLog[]

  @@map("users")
}

model Case {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      CaseStatus @default(OPEN)
  severity    Severity   @default(MEDIUM)
  
  assignedToId String?   @map("assigned_to_id")
  assignedTo   User?     @relation("AssignedAnalyst", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  alerts            Alert[]
  iocs              Ioc[]
  forensicArtifacts ForensicArtifact[]
  incidentReport    Json?              @map("incident_report")

  @@index([status])
  @@index([severity])
  @@index([assignedToId])

  @@map("cases")
}

model Alert {
  id                   String         @id @default(uuid())
  source               String
  description          String
  severity             Severity       @default(MEDIUM)
  status               AlertStatus    @default(NEW)
  score                Float          @default(0.0)
  occurrenceCount      Int            @default(1) @map("occurrence_count")
  lastSeen             DateTime       @default(now()) @map("last_seen")
  llmExplanation       String?        @db.Text @map("llm_explanation")
  llmSuggestedSeverity Severity?      @map("llm_suggested_severity")
  attackTechniqueIds   String[]       @default([]) @map("attack_technique_ids")
  
  sourceIocId          String?        @map("source_ioc_id")
  sourceIoc            Ioc?           @relation(fields: [sourceIocId], references: [id], onDelete: SetNull)
  sourceCveId          String?        @map("source_cve_id")
  sourceCve            Cve?           @relation(fields: [sourceCveId], references: [id], onDelete: SetNull)
  sourceMalwareId      String?        @map("source_malware_id")
  sourceMalware        MalwareSample? @relation(fields: [sourceMalwareId], references: [id], onDelete: SetNull)
  
  ruleId               String?        @map("rule_id")
  rule                 DetectionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  
  relatedCaseId        String?            @map("related_case_id")
  relatedCase          Case?              @relation(fields: [relatedCaseId], references: [id], onDelete: SetNull)

  campaignId           String?        @map("campaign_id")
  campaign             Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  forensicArtifacts    ForensicArtifact[]
  playbookExecutions   PlaybookExecution[]

  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@index([severity])
  @@index([lastSeen])
  @@index([sourceIocId])
  @@index([campaignId])

  @@map("alerts")
}

model DetectionRule {
  id                 String              @id @default(uuid())
  name               String              @unique
  description        String?
  condition          Json
  severity           Severity            @default(HIGH)
  correlationType    RuleCorrelationType @default(SIMPLE) @map("correlation_type")
  enabled            Boolean             @default(true)
  attackTechniqueIds String[]            @default([]) @map("attack_technique_ids")

  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  alerts             Alert[]

  @@map("detection_rules")
}

model Ioc {
  id            String          @id @default(uuid())
  type          IocType
  value         String          @unique
  source        String
  firstSeen     DateTime        @default(now()) @map("first_seen")
  lastSeen      DateTime        @default(now()) @map("last_seen")
  tags          String[]        @default([])
  country       String?
  city          String?
  latitude      Float?
  longitude     Float?
  rawPayload    Json?           @map("raw_payload")
  relatedCaseId String?         @map("related_case_id")
  relatedCase   Case?           @relation(fields: [relatedCaseId], references: [id], onDelete: SetNull)
  campaignId    String?         @map("campaign_id")
  campaign      Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  alerts            Alert[]
  malwareSamples    MalwareSample[]
  forensicArtifacts ForensicArtifact[]

  @@index([type])
  @@index([source])
  @@index([lastSeen])
  @@index([campaignId])

  @@map("iocs")
}

model MalwareSample {
  id            String    @id @default(uuid())
  name          String
  malwareFamily String?   @map("malware_family")
  hashMd5       String?   @map("hash_md5")
  hashSha1      String?   @map("hash_sha1")
  hashSha256    String    @unique @map("hash_sha256")
  fileType      String?   @map("file_type")
  firstSeen     DateTime? @default(now()) @map("first_seen")
  lastSeen      DateTime? @default(now()) @map("last_seen")
  source        String
  tags          String[]  @default([])
  
  relatedIocId  String?   @map("related_ioc_id")
  relatedIoc    Ioc?      @relation(fields: [relatedIocId], references: [id], onDelete: SetNull)
  relatedCveIds   String[]  @default([]) @map("related_cve_ids")
  rawPayload      Json?     @map("raw_payload")
  vtScanResult    Json?     @map("vt_scan_result")
  vtLastScannedAt DateTime? @map("vt_last_scanned_at")
  campaignId      String?   @map("campaign_id")
  campaign        Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  alerts        Alert[]

  @@index([campaignId])

  @@map("malware_samples")
}

model AttackTechnique {
  id          String   @id
  techniqueId String   @unique @map("technique_id")
  name        String
  tactic      String
  description String?  @db.Text
  url         String?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("attack_techniques")
}

model Campaign {
  id                 String          @id @default(uuid())
  name               String
  description        String?         @db.Text
  status             String          @default("ACTIVE")
  firstSeen          DateTime        @default(now()) @map("first_seen")
  lastSeen           DateTime        @default(now()) @map("last_seen")
  attackTechniqueIds String[]        @default([]) @map("attack_technique_ids")
  confidence         Float           @default(0.85)

  alerts             Alert[]
  iocs               Ioc[]
  malwareSamples     MalwareSample[]

  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@map("campaigns")
}

model Cve {
  id               String    @id @default(uuid())
  cveId            String    @unique @map("cve_id")
  description      String?   @db.Text
  cvssScore        Float?    @map("cvss_score")
  publishedDate    DateTime? @map("published_date")
  lastModifiedDate DateTime? @map("last_modified_date")
  source           String
  rawPayload       Json?     @map("raw_payload")

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  alerts           Alert[]

  @@map("cves")
}

model ThreatFeed {
  id           String    @id @default(uuid())
  name         String    @unique
  type         String
  baseUrl      String    @map("base_url")
  enabled      Boolean   @default(true)
  lastSyncedAt DateTime? @map("last_synced_at")

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  syncLogs     FeedSyncLog[]

  @@map("threat_feeds")
}

model FeedSyncLog {
  id              String     @id @default(uuid())
  feedId          String     @map("feed_id")
  feed            ThreatFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  startedAt       DateTime   @default(now()) @map("started_at")
  finishedAt      DateTime?  @map("finished_at")
  status          String
  recordsIngested Int        @default(0) @map("records_ingested")
  errorMessage    String?    @db.Text @map("error_message")

  createdAt       DateTime   @default(now()) @map("created_at")

  @@map("feed_sync_logs")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  targetEntity String   @map("target_entity")
  targetId     String?  @map("target_id")
  ipAddress    String?  @map("ip_address")
  timestamp    DateTime @default(now())

  @@index([timestamp])
  @@index([userId])

  @@map("audit_logs")
}

model ForensicArtifact {
  id             String               @id @default(uuid())
  caseId         String               @map("case_id")
  case           Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  artifactType   ForensicArtifactType @map("artifact_type")
  description    String?
  hash           String?
  collectedBy    String               @map("collected_by")
  collectedAt    DateTime             @default(now()) @map("collected_at")
  chainOfCustody Json                 @map("chain_of_custody")

  relatedIocId   String?              @map("related_ioc_id")
  relatedIoc     Ioc?                 @relation(fields: [relatedIocId], references: [id], onDelete: SetNull)

  relatedAlertId String?              @map("related_alert_id")
  relatedAlert   Alert?               @relation(fields: [relatedAlertId], references: [id], onDelete: SetNull)

  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@map("forensic_artifacts")
}

model Playbook {
  id               String   @id @default(uuid())
  name             String   @unique
  description      String?
  triggerCondition Json     @map("trigger_condition")
  actions          Json
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  executions PlaybookExecution[]

  @@map("playbooks")
}

model PlaybookExecution {
  id         String   @id @default(uuid())
  playbookId String   @map("playbook_id")
  playbook   Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  alertId    String   @map("alert_id")
  alert      Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  actionsRan Json     @map("actions_ran")
  status     String
  executedAt DateTime @default(now()) @map("executed_at")

  @@index([playbookId])
  @@index([alertId])
  @@map("playbook_executions")
}

